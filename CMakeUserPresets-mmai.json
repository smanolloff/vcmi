{
    "version": 10,
    "$comment": [
        "To use this preset, include it via CmakeUserPresets.json",
        "// CmakeUserPresets.json (replace single with double quotes):",
        "{",
        "    'version': 4,",
        "    'vendor': {",
        "        'conan': {}",
        "    },",
        "    'include': [",
        "        'CMakeUserPresets-mmai.json',",
        "        'conan-generated/CMakePresets.json',",
        "        'conan-generated-debug/CMakePresets.json'",
        "    ]",
        "}"
    ],
    "configurePresets": [
        {
            "name": "mmai-common",
            "hidden": true,
            "generator": "Unix Makefiles",
            "cacheVariables": {
                "ENABLE_VIDEO": "OFF",
                "ENABLE_DISCORD": "OFF",
                "ENABLE_TRANSLATIONS": "OFF",
                "ENABLE_CCACHE": "ON",
                "ENABLE_LAUNCHER": "ON",
                "ENABLE_NULLKILLER2_AI": "ON",
                "ENABLE_MMAI": "ON",
                "ENABLE_ML": "ON"
            }
        },
        {
            "name": "mmai-build",
            "inherits": "mmai-common",
            "binaryDir": "${sourceDir}/build",
            "cacheVariables": {
                "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/conan-generated-debug/conan_toolchain.cmake",
                "CMAKE_BUILD_TYPE": "Debug",
                "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
            }
        },
        {
            "name": "mmai-rel",
            "inherits": "mmai-common",
            "binaryDir": "${sourceDir}/rel",
            "cacheVariables": {
                "CMAKE_TOOLCHAIN_FILE": "${sourceDir}/conan-generated/conan_toolchain.cmake",
                "CMAKE_BUILD_TYPE": "Release",
                "CMAKE_EXPORT_COMPILE_COMMANDS": "OFF"
            }
        },
        {
            "name": "mmai-build-play",
            "inherits": "mmai-build",
            "binaryDir": "${sourceDir}/build-play",
            "cacheVariables": {
                "ENABLE_ML": "OFF"
            }
        },
        {
            "name": "mmai-rel-play",
            "inherits": "mmai-rel",
            "binaryDir": "${sourceDir}/rel-play",
            "cacheVariables": {
                "ENABLE_ML": "OFF"
            }
        }
    ]
}
